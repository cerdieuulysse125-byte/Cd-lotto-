import express from "express";
import cors from "cors";

const app = express();
app.use(cors());
app.use(express.json({ limit: '2mb' }));
app.use(express.static('public'));

app.post("/api/print", (req, res) => {
  const { items = [], total = 0, client = "Client", pago = "" } = req.body;

  let esc = "";
  const ESC = "\x1B";
  const GS = "\x1D";
  const LF = "\n";

  esc += ESC + "@"; // INIT
  esc += ESC + "a" + "\x01"; // CENTER
  esc += ESC + "!" + "\x08"; // BOLD
  esc += "C & D SHOP" + LF;
  esc += ESC + "!" + "\x00";
  esc += "Monterrey, NL" + LF;
  esc += "------------------------------" + LF;
  esc += ESC + "a" + "\x00"; // LEFT
  
  esc += `Cliente: ${client}` + LF;
  esc += `Fecha: ${new Date().toLocaleString('es-MX')}` + LF;
  if(pago) esc += `Pago: ${pago}` + LF;
  esc += "------------------------------" + LF;

  items.forEach(it => {
    const name = (it.name || it.nombre || "Prod").substring(0,20);
    const qty = it.qty || it.cantidad || 1;
    const price = it.price || it.precio || 0;
    esc += `${name} x${qty} $${(price*qty).toFixed(2)}` + LF;
  });

  esc += "------------------------------" + LF;
  esc += ESC + "a" + "\x02"; // RIGHT
  esc += ESC + "!" + "\x18"; // DOUBLE HEIGHT + BOLD
  esc += `TOTAL: $${Number(total).toFixed(2)}` + LF;
  esc += ESC + "!" + "\x00";
  esc += ESC + "a" + "\x01"; // CENTER
  esc += LF + "Gracias por su compra!" + LF;
  esc += "Vuelva pronto" + LF + LF + LF;
  esc += GS + "V" + "\x41" + "\x03"; // CUT

  const base64 = Buffer.from(esc, 'latin1').toString('base64');
  res.json({ base64 });
});

// Frontend route
app.get("/", (req, res) => {
  res.sendFile(process.cwd() + "/public/index.html");
});

export default app;
